/// Single source of truth for a multiloader Minecraft mod.
///
/// Don't edit this file. Set your values in `mod.pkl` (which amends this),
/// then regenerate every loader manifest + mixin config with:
///   pkl eval -m build/generated pkl/mod.pkl
///
/// Add a mixin by adding its class name to `commonMixins` / `clientMixins`
/// in mod.pkl. It lands in every loader's config at once. You never hand-edit
/// fabric.mod.json, quilt.mod.json, or neoforge.mods.toml.
open module Mod

id: String(matches(Regex(#"[a-z][a-z0-9_]*"#)))
name: String
version: String = "1.0.0"
group: String(matches(Regex(#"[a-z][a-z0-9_]*(\.[a-z][a-z0-9_]*)*"#)))
authors: Listing<String> = new {}
license: String = "All Rights Reserved"
description: String = "A Minecraft mod."

mcVersion: String
javaVersion: Int = 25

fabricLoaderVersion: String
quiltLoaderVersion: String
neoVersion: String

hasClient: Boolean = true

mixinPackage: String = group + ".mixin"
commonMixins: Listing<String> = new {}
clientMixins: Listing<String> = new {}

// Loader entrypoints are tiny Java shims that call common init().
// Always Java, so no language adapter dependency is needed.
fabricEntry: String = group + ".fabric.FabricEntry"
fabricClientEntry: String = group + ".fabric.FabricClientEntry"
quiltEntry: String = group + ".quilt.QuiltEntry"
quiltClientEntry: String = group + ".quilt.QuiltClientEntry"

// ---------- derived manifests (do not edit) ----------

local fabricMod: Dynamic = new {
  schemaVersion = 1
  id = module.id
  version = module.version
  name = module.name
  description = module.description
  authors = module.authors
  license = module.license
  environment = "*"
  entrypoints = new Dynamic {
    main = new Listing { module.fabricEntry }
    when (module.hasClient) {
      client = new Listing { module.fabricClientEntry }
    }
  }
  mixins = new Listing {
    "\(module.id).mixins.json"
    when (module.hasClient) {
      new Dynamic {
        config = "\(module.id).client.mixins.json"
        environment = "client"
      }
    }
  }
  depends = new Dynamic {
    fabricloader = ">=\(module.fabricLoaderVersion)"
    minecraft = "~\(module.mcVersion)"
    java = ">=\(module.javaVersion)"
  }
}

local quiltMod: Dynamic = new {
  schema_version = 1
  quilt_loader = new Dynamic {
    group = module.group
    id = module.id
    version = module.version
    metadata = new Dynamic {
      name = module.name
      description = module.description
      contributors = new Mapping {
        for (a in module.authors) {
          [a] = "Owner"
        }
      }
      license = module.license
    }
    entrypoints = new Dynamic {
      init = new Listing { module.quiltEntry }
      when (module.hasClient) {
        client_init = new Listing { module.quiltClientEntry }
      }
    }
    depends = new Listing {
      new Dynamic { id = "quilt_loader"; versions = ">=\(module.quiltLoaderVersion)" }
      new Dynamic { id = "minecraft"; versions = "~\(module.mcVersion)" }
    }
  }
  mixin = new Listing {
    "\(module.id).mixins.json"
    when (module.hasClient) { "\(module.id).client.mixins.json" }
  }
}

local mixinsMain: Dynamic = new {
  required = true
  ["package"] = module.mixinPackage
  compatibilityLevel = "JAVA_\(module.javaVersion)"
  mixins = module.commonMixins
  injectors = new Dynamic { defaultRequire = 1 }
}

local mixinsClient: Dynamic = new {
  required = true
  ["package"] = module.mixinPackage + ".client"
  compatibilityLevel = "JAVA_\(module.javaVersion)"
  mixins = module.clientMixins
  injectors = new Dynamic { defaultRequire = 1 }
}

// Pkl has no built-in TOML renderer. A JSON-quoted string is a valid TOML
// basic string, so we reuse JsonRenderer to escape values correctly.
local function tstr(s: String): String = (new JsonRenderer {}).renderValue(s)

local neoToml: String = (new Listing {
  "modLoader = \(tstr("javafml"))"
  "loaderVersion = \(tstr("[1,)"))"
  "license = \(tstr(module.license))"
  ""
  "[[mods]]"
  "  modId = \(tstr(module.id))"
  "  version = \(tstr(module.version))"
  "  displayName = \(tstr(module.name))"
  "  description = \(tstr(module.description))"
  "  authors = \(tstr(module.authors.toList().join(", ")))"
  ""
  "[[mixins]]"
  "  config = \(tstr("\(module.id).mixins.json"))"
  when (module.hasClient) {
    "[[mixins]]"
    "  config = \(tstr("\(module.id).client.mixins.json"))"
  }
  ""
  "[[dependencies.\(module.id)]]"
  "  modId = \(tstr("neoforge"))"
  "  type = \(tstr("required"))"
  "  versionRange = \(tstr("[\(module.neoVersion),)"))"
  "  ordering = \(tstr("NONE"))"
  "  side = \(tstr("BOTH"))"
  ""
  "[[dependencies.\(module.id)]]"
  "  modId = \(tstr("minecraft"))"
  "  type = \(tstr("required"))"
  "  versionRange = \(tstr("[\(module.mcVersion),)"))"
  "  ordering = \(tstr("NONE"))"
  "  side = \(tstr("BOTH"))"
}).toList().join("\n") + "\n"

output {
  files {
    ["fabric/fabric.mod.json"] {
      value = fabricMod
      renderer = new JsonRenderer {}
    }
    ["quilt/quilt.mod.json"] {
      value = quiltMod
      renderer = new JsonRenderer {}
    }
    ["common/\(module.id).mixins.json"] {
      value = mixinsMain
      renderer = new JsonRenderer {}
    }
    ["common/\(module.id).client.mixins.json"] {
      value = mixinsClient
      renderer = new JsonRenderer {}
    }
    ["neoforge/neoforge.mods.toml"] {
      text = neoToml
    }
  }
}
