amends "render.pkl"

// this is the project file generated for you
// edit values here and leave render.pkl alone

// identity
id = "modid"
name = "Modid"
version = "1.0.0"
group = "com.example.modid"
authors = new { "yourname" }
license = "MIT"
description = "A Minecraft mod."

// archetype
// side accepts both, client, or server
// language accepts java, kotlin, or scala
side = "both"
language = "java"
datagen = true

// minecraft and loader versions
mcVersion = "26.1.2"
fabricLoaderVersion = "0.19.3"
neoVersion = "26.1.2.73"
fabricApiVersion = "0.151.0+26.1.2"
scalaVersion = "3.8.3"

// mixins stay in java even when the project language is kotlin or scala
commonMixins = new { "BootstrapMixin" }
clientMixins = new { "TitleScreenMixin" }

// each access entry renders to both loader formats
accessEntries = new {
  new {
    kind = "method"
    owner = "net/minecraft/server/Bootstrap"
    member = "wrapStreams"
    descriptor = "()V"
  }
}
