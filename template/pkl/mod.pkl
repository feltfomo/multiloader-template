/// Your mod. Edit these fields, then regenerate manifests:
///   pkl eval -m build/generated pkl/mod.pkl
amends "Mod.pkl"

id = "modid"
name = "Modid"
version = "1.0.0"
group = "com.example.modid"
authors = new { "yourname" }
license = "MIT"
description = "A multiloader example built from one Pkl source."

mcVersion = "26.1.2"
fabricLoaderVersion = "0.19.3"
neoVersion = "26.1.2.73"

// Add mixin class names here; they propagate to every loader.
commonMixins = new {}
clientMixins = new { "TitleScreenScalaMixin" }
