# ---- Gradle / build output ----
.gradle/
.kotlin/
build/
out/

# Pkl-generated manifests live under build/generated/ (covered above).

# ---- Datagen output ----
# runDatagen writes here (Fabric -> src/main/generated, NeoForge -> src/generated).
# The providers are the source of truth; committing their output just drifts the
# day someone edits a provider and forgets to regenerate. Run datagen to recreate.
**/src/main/generated/
**/src/generated/

# Access widener + transformer are rendered here at configure time (outside
# build/ so a clean build can't delete them before the loaders read them).
.pkl-generated/

# ---- Minecraft / Loom / NeoForge dev runs ----
run/
runs/
run-data/
.architectury-transformer/
*.log

# ---- Nix ----
result
result-*
.direnv/

# ---- IDE ----
.idea/
*.iml
*.ipr
*.iws
.vscode/
*.code-workspace
.settings/
.classpath
.project
bin/
.fleet/

# ---- OS junk ----
.DS_Store
Thumbs.db

# ---- Keep the Gradle wrapper jar ----
!gradle/wrapper/gradle-wrapper.jar
